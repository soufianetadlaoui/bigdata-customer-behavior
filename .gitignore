@"
# Donnees (trop volumineuses pour Git)
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
!data/**/.gitkeep
*.csv
*.parquet
*.zip
*.log

# Resultats agreges (petits, a versionner)
!docs/results/*.csv

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Environnement / secrets
.env

# IDE / OS
.vscode/
.idea/
.DS_Store

# Spark
spark-warehouse/
metastore_db/
derby.log
"@ | Out-File -Encoding ascii .gitignore